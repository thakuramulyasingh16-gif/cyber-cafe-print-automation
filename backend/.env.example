# Environment variables for backend
# Copy this file to .env and fill in your values

# Server
PORT=3001
NODE_ENV=development

# Database (SQLite for development)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# File uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Redis (optional - for Bull queue, falls back to in-memory)
REDIS_URL=redis://localhost:6379
USE_REDIS=false

# Print agent authentication token
PRINT_AGENT_TOKEN=your-print-agent-token-here

# Frontend URLs (for CORS)
CUSTOMER_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174

# QR Code base URL (customer portal URL)
PORTAL_BASE_URL=http://localhost:5173

# Admin seed account (for initial setup)
ADMIN_EMAIL=admin@cybercafe.local
ADMIN_PASSWORD=change-me-admin-password
ADMIN_NAME=Admin

# Razorpay (online payments - leave empty to disable)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
