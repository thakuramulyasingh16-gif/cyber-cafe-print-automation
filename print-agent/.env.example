# Print Agent environment variables
# Copy this file to .env and fill in your values

BACKEND_URL=http://localhost:3001
AGENT_TOKEN=your-print-agent-token-here

# Printer name (Windows printer name, leave blank to use system default)
PRINTER_NAME=

# Adapter: WINDOWS or MOCK
# Use MOCK for testing without a real printer
PRINT_ADAPTER=MOCK

# Poll interval (ms) - how often to check for new jobs
POLL_INTERVAL=3000

# Download directory for temp files
TEMP_DIR=./temp
